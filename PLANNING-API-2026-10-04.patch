+// Calculator import policy: absence notices have no charge. All other unknowns stay blocked.
+import {projectBalanceMonth} from './feecalcBilling.generated.js';
+export function projectCalculatorBalanceMonth(student,month,rows,...args){
+ return projectBalanceMonth(student,month,rows.filter(row=>row.kind!=='absence'),...args);
+}
+// Same display subtotal as balanceOpeningEstimate.ts; it is never an import amount.
+export function openingDisplayEstimate(month,periods,summaries,start='2026-09'){
+ let amount=0,pendingMonths=[];
+ const next=m=>{const d=new Date(m+'-01T00:00:00Z');d.setUTCMonth(d.getUTCMonth()+1);return d.toISOString().slice(0,7);};
+ for(let m=start;m<=month;m=next(m)){
+  const saved=periods[m]?.opening?.amount;
+  if(saved!=null){amount=Number.isFinite(saved)?saved:null;pendingMonths=[];}
+  if(m===month)break;
+  const row=summaries.find(s=>s.month===m),paid=periods[m]?.paid?.amount??row?.paid;
+  if(!row||!Number.isFinite(row.charges)||!Number.isFinite(paid)){amount=null;continue;}
+  if(row.unresolved>0)pendingMonths.push({month:m,count:row.unresolved});
+  if(amount!==null)amount=Math.round((amount+row.charges-paid)*100)/100;
+ }
+ return {amount,pendingMonths,unresolved:pendingMonths.reduce((n,p)=>n+p.count,0)};
+}
